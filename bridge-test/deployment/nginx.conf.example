# Example only: configure your own domain/certificate and enable manually.
# Bind bridge to loopback: BRIDGE_HOST=127.0.0.1 ...
# This limit_req_zone belongs in nginx's http context.
limit_req_zone $binary_remote_addr zone=bridge_login:10m rate=6r/m;
server {
    listen 80;
    server_name bridge.example.kz;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name bridge.example.kz;
    ssl_certificate /etc/letsencrypt/live/bridge.example.kz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bridge.example.kz/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 32k;
    access_log off;
    location = /api/login {
        limit_req zone=bridge_login burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:1740;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 90s;
    }
    location / {
        proxy_pass http://127.0.0.1:1740;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 90s;
    }
}
