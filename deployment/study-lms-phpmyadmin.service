[Unit]
Description=Study LMS phpMyAdmin GUI
After=network.target mariadb.service
Wants=mariadb.service

[Service]
Type=simple
User=apache
Group=apache
WorkingDirectory=/usr/share/phpMyAdmin
RuntimeDirectory=study-lms-phpmyadmin
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/php -d session.save_path=/run/study-lms-phpmyadmin -S 0.0.0.0:5000 -t /usr/share/phpMyAdmin
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/usr/share/phpMyAdmin /etc/phpMyAdmin

[Install]
WantedBy=multi-user.target
